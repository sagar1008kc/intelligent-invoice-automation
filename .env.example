# xAI Grok API key — copy this file to .env and paste your key locally.
# NEVER commit .env. Rotate any key that was shared in chat.
XAI_API_KEY=your_xai_api_key_here

# Model name (examples: grok-3, grok-4, grok-4.5)
XAI_MODEL=grok-3

# Optional overrides
INVENTORY_DB_PATH=inventory.db
LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.7
APPROVAL_AMOUNT_THRESHOLD=10000
MAX_EXTRACTION_RETRIES=2
